{
  "name": "givewp/flutterwave",
  "description": "Flutterwave payment gateway integration for GiveWP.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "pestphp/pest": "^2.36"
  },
  "autoload": {
    "psr-4": {
      "GiveFlutterwave\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GiveFlutterwave\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
